<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
        <AssemblyName>KodeAid.Testing</AssemblyName>
        <RootNamespace>KodeAid.Testing</RootNamespace>
        <Version>1.7.0</Version>
        <Description>Kode-Aid shared testing helpers library.</Description>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.*" />
        <ProjectReference Include="..\Nullability\Nullability.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Common\Common.csproj" />
    </ItemGroup>

</Project>
